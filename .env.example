# Copy to .env.local (never commit real values).

# Database: defaults to the local file when unset. For Turso: libsql://<db>-<org>.turso.io
DATABASE_URL=
DATABASE_AUTH_TOKEN=

# Username that existing application statuses are assigned to (default: local).
OWNER_USER_ID=
# Friends and family logins: name:password,name:password. Unset = no login (local user).
BASIC_AUTH_USERS=
# Shared secret for the nightly ingest revalidation webhook.
REVALIDATE_SECRET=

# SERP gap-fill (optional; free tiers only, always run with --max-queries)
SERPER_API_KEY=
SERPAPI_API_KEY=
